# Jev (TypeSafe AI の API)。BASE_URL は空なら https://api.typesafe.ai
JEV_API_KEY=
JEV_API_BASE_URL=

# Laya (laya-serve の接続先。空なら http://localhost:8000)
LAYA_ENDPOINT=
# laya-serve 側で LAYA_API_KEY を設定した場合のみ
LAYA_API_KEY=

# LLM API (既定は Anthropic Messages API。キーが空なら ANTHROPIC_API_KEY を使う)
LLM_API_KEY=
# 空なら https://api.anthropic.com（api_format="openai" のときは必須）
LLM_API_BASE_URL=
# ローカル LLM (OpenAI 互換。空なら Ollama の http://localhost:11434/v1)
LLM_LOCAL_ENDPOINT=
# ローカルサーバ側でキーを要求する場合のみ
LLM_LOCAL_API_KEY=
